{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "reviewer": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
