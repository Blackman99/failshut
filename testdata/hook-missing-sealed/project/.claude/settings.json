      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-src-writes.sh" },
          { "type": "command", "command": "bash '.claude/hooks/rel guard.sh'" }
        ]
      }
    ]
  }
}
